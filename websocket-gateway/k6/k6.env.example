# run-local.sh / run-cloud.sh 가 읽는 파일. 실제 k6.env 는 저장소에 두지 않는다.
# 토큰은 유효시간이 짧으므로(약 2시간) 측정 직전에 발급해 갈아끼운다.

# 클라우드 실행이면 맥의 Tailscale IP, 로컬 실행이면 localhost
WS_BASE_URL=wss://100.x.x.x:8000

# 계정 2개를 전 VU 가 공유한다. VU 별 자격증명은 TODO.md 5.4
TOKEN_USER_1=eyJ...
WRITER_ID_1=00000000-0000-0000-0000-000000000000
TOKEN_USER_2=eyJ...
WRITER_ID_2=00000000-0000-0000-0000-000000000000

# 모든 VU 가 들어갈 방. 멤버는 미리 넣어둔다.
ROOM_ID=000000000000000000000000
