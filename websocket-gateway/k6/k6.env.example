# run.sh 가 읽는 파일. 실제 k6.env 는 저장소에 두지 않는다.

# 클라우드(OCI)에서 돌리면 맥의 Tailscale IP, 로컬이면 localhost
WS_BASE_URL=wss://localhost:8000

# 모든 VU 가 들어갈 방. tools/seed-room-members.sh 가 이 방에 계정을 넣는다.
ROOM_ID=000000000000000000000000

# 아래 둘은 accounts/test-users.json 이 없을 때만 쓰는 폴백이다(계정 2개 공유 = 이전 회차 조건).
# 정상 경로는 tools/mint-test-users.py 로 계정을 발급하는 것이다. 토큰 유효시간은 발급 시 정한다.
# TOKEN_USER_1=eyJ...
# WRITER_ID_1=00000000-0000-0000-0000-000000000000
# TOKEN_USER_2=eyJ...
# WRITER_ID_2=00000000-0000-0000-0000-000000000000
